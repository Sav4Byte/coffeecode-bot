                elif text.startswith("/help"):\
                    send(chat_id, "\uc0\u8505 \u65039  \u1055 \u1088 \u1086 \u1089 \u1090 \u1086  \u1085 \u1072 \u1087 \u1080 \u1096 \u1080  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089  \'97 \u1086 \u1090 \u1074 \u1077 \u1095 \u1091 . Powered by Google Gemini.")\
                else:\
