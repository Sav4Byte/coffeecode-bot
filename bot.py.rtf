\
SYSTEM_PROMPT = (\
    "\uc0\u1054 \u1090 \u1074 \u1077 \u1095 \u1072 \u1081  \u1087 \u1088 \u1086 \u1089 \u1090 \u1099 \u1084  \u1090 \u1077 \u1082 \u1089 \u1090 \u1086 \u1084  \u1073 \u1077 \u1079  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090 \u1080 \u1088 \u1086 \u1074 \u1072 \u1085 \u1080 \u1103 : \u1073 \u1077 \u1079  \u1079 \u1074 \u1105 \u1079 \u1076 \u1086 \u1095 \u1077 \u1082 , \u1088 \u1077 \u1096 \u1105 \u1090 \u1086 \u1082 , "\
