        try:\
            r = requests.get(\
                f"https://api.telegram.org/bot\{BOT_TOKEN\}/getUpdates",\
                params=\{"offset": offset, "timeout": 25\},\
                timeout=35\
            ).json()\
\
            for upd in r.get("result", []):\
                offset = upd["update_id"] + 1\
                msg    = upd.get("message", \{\})\
                text   = msg.get("text", "")\
